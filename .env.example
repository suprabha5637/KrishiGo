# ============================================================
# KrishiGo Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=KrishiGo
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=KrishiGo
NEXT_PUBLIC_APP_TAGLINE=Fresh from Farms. Faster to You.

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://krishigo:krishigo_dev@localhost:5432/krishigo
POSTGRES_USER=krishigo
POSTGRES_PASSWORD=krishigo_dev
POSTGRES_DB=krishigo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Authentication ----
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- AWS S3 (File Storage) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=krishigo-uploads

# ---- Payment Provider ----
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# ---- Weather API ----
WEATHER_API_KEY=
WEATHER_PROVIDER=mock

# ---- AI/ML ----
AI_API_KEY=
AI_PROVIDER=mock

# ---- Notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=mock
SMS_API_KEY=
