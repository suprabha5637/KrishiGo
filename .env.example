# ============================================================
# KrishiGo — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# See docs/api/google.md for API key setup instructions.
# ============================================================

# ── Application ───────────────────────────────────────────
APP_NAME=KrishiGo
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# ── Backend Server ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────
# Development (SQLite — default, no setup required):
DATABASE_URL=sqlite+aiosqlite:///./krishigo.db

# Production (PostgreSQL — recommended):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/krishigo
# POSTGRES_USER=krishigo
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=krishigo
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google Maps Platform ──────────────────────────────────
# One key covers: Geocoding, Places, Routes, Weather, Air Quality, Pollen, Time Zone
# Restrict this key to your server IP in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ── Google Gemini AI ──────────────────────────────────────
# Used for: Farm Copilot, AI search, crop health analysis
# NEVER put this in frontend VITE_* variables.
GEMINI_API_KEY=

# ── Weather Provider ──────────────────────────────────────
# Primary: google (uses GOOGLE_MAPS_API_KEY above)
# Fallback: open_meteo (no key required)
WEATHER_PROVIDER=google

# ── Payment Provider ──────────────────────────────────────
PAYMENT_PROVIDER=mock
# For Razorpay production:
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Notifications ─────────────────────────────────────────
# SMTP (email):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# SMS:
# SMS_PROVIDER=mock
# SMS_API_KEY=

# ── Redis (optional, for production caching) ──────────────
# REDIS_URL=redis://localhost:6379/0

# ── Firebase Admin (optional, for server-side auth verify) 
# GOOGLE_APPLICATION_CREDENTIALS=backend/service-account.json

# ============================================================
# FRONTEND VARIABLES (go in frontend/.env, NOT this file)
# ============================================================
# These VITE_* variables are safe to expose to the browser.
# Create frontend/.env with:
#
# VITE_GOOGLE_MAPS_API_KEY=           ← Restricted to your domain
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
